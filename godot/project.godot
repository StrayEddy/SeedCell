; SeedCell digital twin -- Godot 4 project.
; Headless self-tests live in tests/ and are run by scripts/run_selftest.sh.

config_version=5

[application]

config/name="SeedCell Digital Twin"
run/main_scene="res://process_demo.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

anti_aliasing/quality/msaa_3d=2
